{
  "name": "server-ui",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "module": "./dist/ui.js",
  "exports": {
    ".": {
      "import": "./dist/ui.js"
    }
  },
  "scripts": {
    "gendata": "node scripts/gendata.js http://meilitest:7700",
    "dev": "shx mkdir -p ../../test-cert && vite",
    "check": "tsc && eslint src",
    "build": "shx mkdir -p ../../test-cert && tsc && vite build",
    "dist": "shx mkdir -p ../../test-cert && vite build && shx mkdir -p ../../backend/ui-dist && shx cp -r dist/* ../../backend/ui-dist/",
    "preview": "shx mkdir -p ../../test-cert && vite preview"
  },
  "devDependencies": {
    "@gisst/vite-mock-api": "^4.0.1",
    "@types/google.maps": "^3.66.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.1",
    "meilisearch": "^0.57.0",
    "shx": "^0.4",
    "vite": "^8.0.16",
    "vite-plugin-checker": "^0.9.0",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-mkcert": "^1.17.7"
  },
  "dependencies": {
    "@gisst/instant-meilisearch": "^0.32.0",
    "gisst-style": "file:../gisst-style",
    "instantsearch.css": "^8.25.0",
    "instantsearch.js": "^4.122.0",
    "spark-md5": "^3.0.2",
    "tus-js-client": "^4.3.1"
  }
}
